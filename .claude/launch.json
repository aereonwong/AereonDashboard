{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AereonDashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3007,
      "autoPort": true
    },
    {
      "name": "AereonDashboard (no passcode)",
      "runtimeExecutable": "env",
      "runtimeArgs": ["APP_PASSCODE=", "npm", "run", "dev"],
      "port": 3008,
      "autoPort": true
    }
  ]
}

{
  "name": "aereondashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs",
    "webhook:info": "node --env-file-if-exists=.env scripts/webhook-info.mjs",
    "import": "node --env-file-if-exists=.env scripts/import.mjs",
    "ig:refresh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/ig-refresh.mjs",
    "drive:reconcile": "node --env-file-if-exists=.env scripts/drive-reconcile.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@composio/core": "^0.18.1",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
